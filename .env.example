# =============================================================================
# Bonaire Patacona — environment
#
#   cp .env.example .env
#   node scripts/generate-supabase-keys.mjs >> .env    # fills the secrets below
#
# On Dokploy / Dockhand / Coolify paste these as the application's environment
# variables instead of committing a .env file.
# =============================================================================

# --- Public URLs -------------------------------------------------------------
# Where the Nuxt site is served from.
SITE_URL=https://bonairepatacona.com
# Where the Supabase gateway (kong) is reachable from the browser.
SUPABASE_PUBLIC_URL=https://api.bonairepatacona.com
# Extra redirect targets allowed after auth emails (comma separated).
ADDITIONAL_REDIRECT_URLS=https://bonairepatacona.com/admin

# --- Ports (host side) -------------------------------------------------------
APP_PORT=3000
KONG_HTTP_PORT=8000

# --- Supabase secrets — generate, never invent -------------------------------
# node scripts/generate-supabase-keys.mjs
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=
DASHBOARD_PASSWORD=
CRON_SECRET=

POSTGRES_DB=postgres
JWT_EXPIRY=3600
DASHBOARD_USERNAME=supabase
STUDIO_DEFAULT_ORGANIZATION=Bonaire
STUDIO_DEFAULT_PROJECT=Bonaire Patacona

# Back-office accounts are invited by the owner. Keep sign-up disabled.
DISABLE_SIGNUP=true
# Set to true only if you have no SMTP server and accept unverified emails.
MAILER_AUTOCONFIRM=false

# --- SMTP (password resets and invites for the admin panel) ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=hola@bonairepatacona.com
SMTP_SENDER_NAME=Bonaire Patacona

# --- Stripe ------------------------------------------------------------------
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Dashboard -> Developers -> Webhooks -> endpoint https://<site>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired,
#         payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Booking engine ----------------------------------------------------------
ICAL_SYNC_ENABLED=true
TZ=Europe/Madrid

# --- Local development only --------------------------------------------------
# `npm run dev` reads these two directly (they mirror the NUXT_PUBLIC_* pair).
SUPABASE_URL=http://localhost:8000
SUPABASE_KEY=
